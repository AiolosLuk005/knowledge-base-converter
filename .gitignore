# ====================================================================
# 1. 你原有的自定义规则（保留并规范化格式）
# ====================================================================
/data/
/venv/
config.ini
password.txt
*.log
*.temp
backup*
test_output.csv
/temp_data/

# ====================================================================
# 2. 针对 Python & AI 运行环境的深度清理（解决海量小文件扫描）
# ====================================================================
# 彻底忽略 Python 自动生成的字节码缓存（这是最容易产生几千个变动的地方）
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# 忽略本地开发环境及临时打包文件
.env
.venv
env/
ENV/
build/
dist/
dist_portable/
*.egg-info/

# ====================================================================
# 3. 针对“前端数据库/档案管理”及大文件的专项忽略
# ====================================================================
# 忽略常见的本地数据库文件（防止数据库更新时 Git 疯狂记录二进制变动）
*.db
*.db-journal
*.sqlite
*.sqlite3

# 忽略常见的海量文档与压缩包备份（如果它们被误放进了项目根目录）
*.zip
*.tar.gz
*.rar
*.7z

# ====================================================================
# 4. 操作系统与编辑器缓存
# ====================================================================
# Windows 系统文件夹缩略图与属性缓存
Thumbs.db
ehthumbs.db
Desktop.ini

# 编辑器与 AI 插件本地缓存
.vscode/
.idea/
.cascade/